	partition Rules = m
		mode: import
		queryGroup: Model
		source =
				// One row per rule: the register's entry with tonight's result, the planted defect result and the measured effect. Filters the exceptions and reasons.
				let
				    // Read the file from the data branch
				    Source = fnRepoCsv("rules_tonight.csv"),
				    // Give every column its type. en-US means numbers use a dot, and dates are read as written, year first
				    Typed = Table.TransformColumnTypes(Source, {{"rule_order", Int64.Type}, {"id", type text}, {"rule_label", type text}, {"version", Int64.Type}, {"title", type text}, {"why", type text}, {"dataset", type text}, {"fields", type text}, {"dimension", type text}, {"severity", type text}, {"fail_above", type number}, {"review_above", type number}, {"owner_role", type text}, {"steward_role", type text}, {"action", type text}, {"root_cause", type text}, {"condition", type text}, {"eligible", Int64.Type}, {"failed", Int64.Type}, {"excluded", Int64.Type}, {"failed_pct", type number}, {"status", type text}, {"note", type text}, {"exceptions_shown", Int64.Type}, {"exceptions_hidden", Int64.Type}, {"test_outcome", type text}, {"test_failed_before", Int64.Type}, {"test_failed_after", Int64.Type}, {"figure", type text}, {"careful", type number}, {"careless", type number}, {"unit", type text}, {"effect_pct", type number}, {"measured", type logical}, {"fix_rank", Int64.Type}, {"months_packed", type text}, {"runs_packed", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
