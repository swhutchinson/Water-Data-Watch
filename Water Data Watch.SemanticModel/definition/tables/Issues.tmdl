/// Every issue ever opened. The engine opens and closes them; due dates are illustrative.
table Issues
	lineageTag: 957f8504-76c1-4e72-a28b-a4587dd2047e

	column issue_id
		dataType: string
		lineageTag: b2d7db60-1114-487f-8291-6cbb3a9126cf
		summarizeBy: none
		sourceColumn: issue_id

	column rule_id
		dataType: string
		isHidden
		lineageTag: 022bfbef-a202-401d-97be-9529fa2fa2e6
		summarizeBy: none
		sourceColumn: rule_id

	column state
		dataType: string
		lineageTag: 2d35cd7e-843f-42a3-a8eb-9e6e7a8ebfe3
		summarizeBy: none
		sourceColumn: state

	column opened_on
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: cf12293f-4f69-4883-a019-da070db5cb86
		summarizeBy: none
		sourceColumn: opened_on

	column opened_run
		dataType: string
		isHidden
		lineageTag: 62055a83-fd5e-4581-a21e-9879882c2a42
		summarizeBy: none
		sourceColumn: opened_run

	column due_on
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: e7575e24-f71c-403e-956c-d967ca9c894e
		summarizeBy: none
		sourceColumn: due_on

	column closed_on
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 7ac8d90c-896c-4dcc-95bd-19d42e864c32
		summarizeBy: none
		sourceColumn: closed_on

	column latest_status
		dataType: string
		lineageTag: 7b347c50-5684-43be-ae7f-6ea022a9bc28
		summarizeBy: none
		sourceColumn: latest_status

	column passes_in_a_row
		dataType: int64
		formatString: #,0
		lineageTag: f92a1bc0-6a71-4bf5-9476-049d52dece70
		summarizeBy: none
		sourceColumn: passes_in_a_row

	column last_failed_count
		dataType: int64
		formatString: #,0
		lineageTag: a6faaaf7-11bb-428a-ad65-95ebfe81a3fc
		summarizeBy: none
		sourceColumn: last_failed_count

	partition Issues = m
		mode: import
		queryGroup: Model
		source =
				// Every issue ever opened. The engine opens and closes them; due dates are illustrative.
				let
				    // Read the file from the data branch
				    Source = fnRepoCsv("history/issues.csv"),
				    // Give every column its type. en-US means numbers use a dot, and dates are read as written, year first
				    Typed = Table.TransformColumnTypes(Source, {{"issue_id", type text}, {"rule_id", type text}, {"state", type text}, {"opened_on", type date}, {"opened_run", type text}, {"due_on", type date}, {"closed_on", type date}, {"latest_status", type text}, {"passes_in_a_row", Int64.Type}, {"last_failed_count", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

