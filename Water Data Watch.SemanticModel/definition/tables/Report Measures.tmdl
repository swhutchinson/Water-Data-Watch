	/// The sub-area ranked highest the quick way.
	measure 'Quick Top Area' =
			// The sub-area ranked highest the quick way.
			VAR KeyNow = [Quick Key]
			RETURN CALCULATE ( MAX ( SameData[area_name] ), REMOVEFILTERS ( SameData ), SameData[scenario_key] = KeyNow, SameData[area_rank] = 1 )
		displayFolder: Same data
