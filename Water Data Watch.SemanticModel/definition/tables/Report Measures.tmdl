/// Holds every measure. Its one column is a hidden placeholder, because a table must have a column.
table 'Report Measures'
	lineageTag: 02cab197-86e2-4d13-abfd-c3edf68bfb47

	/// The number of the newest run in the log, which every figure from the last check reads.
	measure 'Latest Run No' =
			// The number of the newest run in the log, which every figure from the last check reads.
			CALCULATE ( MAX ( RunLog[RunNo] ), REMOVEFILTERS ( RunLog ) )
		formatString: #,0
		displayFolder: Latest run
		lineageTag: b0db438a-295b-4b2f-a39e-07987747c26a

	/// How many runs the log holds.
	measure 'Run Count' =
			// How many runs the log holds.
			CALCULATE ( COUNTROWS ( RunLog ), REMOVEFILTERS ( RunLog ) )
		formatString: #,0
		displayFolder: Latest run
		lineageTag: 628b3bd1-e5e9-4f9a-b718-fa614e1ca3bf

	/// The date of the first run. Nothing the engine measures goes back further.
	measure 'Tracking Since' =
			// The date of the first run. Nothing the engine measures goes back further.
			CALCULATE ( MIN ( RunLog[as_of] ), REMOVEFILTERS ( RunLog ) )
		formatString: d mmm yyyy
		displayFolder: Latest run
		lineageTag: 92d89fed-0433-4bff-a91b-c79828c77c4a

	/// Days since tracking began, counting the first day, measured to the last refresh.
	measure 'Days Tracked' =
			// Days since tracking began, counting the first day, measured to the last refresh.
			VAR Since = [Tracking Since]
			VAR RefreshDay = MAX ( RefreshInfo[RefreshedUKDate] )
			RETURN IF ( NOT ISBLANK ( Since ), DATEDIFF ( Since, RefreshDay, DAY ) + 1 )
		formatString: #,0
		displayFolder: Latest run
		lineageTag: 605efa13-4842-45aa-8704-5dfdf9a385d4

	/// States when tracking began, because trends and histories can only go back that far.
	measure 'Tracking Text' =
			// States when tracking began, because trends and histories can only go back that far.
			VAR Days = [Days Tracked]
			RETURN
			    "Tracking since " & FORMAT ( [Tracking Since], "d mmm yyyy" )
			        & IF ( Days = 1, " (day 1)", " (" & FORMAT ( Days, "#,0" ) & " days)" )
		displayFolder: Latest run
		lineageTag: e87108f3-af73-4c2a-bf8c-928e6001c6c5

	/// When the newest run finished, in UK time.
	measure 'Last Check Text' =
			// When the newest run finished, in UK time.
			VAR Latest = [Latest Run No]
			RETURN CALCULATE ( MAX ( RunLog[RunUKText] ), REMOVEFILTERS ( RunLog ), RunLog[RunNo] = Latest )
		displayFolder: Latest run
		lineageTag: 18afb01d-e050-4438-88a9-0bcab3bf394e

	/// Hours between the newest run finishing and the last refresh. The refresh time is the report's only now.
	measure 'Hours Since Check' =
			// Hours between the newest run finishing and the last refresh. The refresh time is the report's only "now".
			VAR Latest = [Latest Run No]
			VAR RunTime = CALCULATE ( MAX ( RunLog[RunUTC] ), REMOVEFILTERS ( RunLog ), RunLog[RunNo] = Latest )
			VAR RefreshTime = MAX ( RefreshInfo[RefreshedUTC] )
			RETURN IF ( NOT ISBLANK ( RunTime ), DATEDIFF ( RunTime, RefreshTime, HOUR ) )
		formatString: #,0
		displayFolder: Latest run
		lineageTag: 99e9b6de-02cc-48e4-8ad2-be13a3fdbc8b

	/// A warning once the newest run is over 36 hours old. GitHub can start a nightly run hours late, so a day alone isn't a problem.
	measure 'Stale Warning' =
			// A warning once the newest run is over 36 hours old. GitHub can start a nightly run hours late, so a day alone isn't a problem.
			VAR Hours = [Hours Since Check]
			RETURN IF ( Hours > 36, "The last check is " & FORMAT ( ROUNDDOWN ( Hours / 24, 0 ), "0" ) & " days old", "" )
		displayFolder: Latest run
		lineageTag: b1134639-b8ca-4a57-8038-680baed6068d

	/// The header's freshness line: last check, tracking start and any warning.
	measure 'Freshness Text' =
			// The header's freshness line: last check, tracking start and any warning.
			VAR Warning = [Stale Warning]
			RETURN
			    "Last check " & [Last Check Text] & "  ·  " & [Tracking Text]
			        & IF ( Warning <> "", "  ·  " & Warning )
		displayFolder: Latest run
		lineageTag: 84bd28c3-eb3b-4946-9df0-8107df028f98

	/// Rows the source says it holds.
	measure 'Source Rows' =
			// Rows the source says it holds.
			CALCULATE ( SUM ( ControlTotals[row_count] ), ControlTotals[stage_no] = 1 )
		formatString: #,0
		displayFolder: Latest run
		lineageTag: d85df096-dc0b-449e-a93c-73a156079e5f

	/// Rows that arrived.
	measure 'Arrived Rows' =
			// Rows that arrived.
			CALCULATE ( SUM ( ControlTotals[row_count] ), ControlTotals[stage_no] = 2 )
		formatString: #,0
		displayFolder: Latest run
		lineageTag: 9eb5aa22-627f-4df8-a042-6fae92baf8fe

	/// Rows the rules checked.
	measure 'Checked Rows' =
			// Rows the rules checked.
			CALCULATE ( SUM ( ControlTotals[row_count] ), ControlTotals[stage_no] = 3 )
		formatString: #,0
		displayFolder: Latest run
		lineageTag: 5fd6d643-5c75-4b21-b769-e850c9b9cc9a

	/// Rows the report's summaries add up to.
	measure 'Summarised Rows' =
			// Rows the report's summaries add up to.
			CALCULATE ( SUM ( ControlTotals[row_count] ), ControlTotals[stage_no] = 4 )
		formatString: #,0
		displayFolder: Latest run
		lineageTag: 3422d624-0456-4de4-96d8-4efaade35a10

	/// 1 when the row count is the same at all four stages, so nothing was lost on the way.
	measure 'Totals Agree' =
			// 1 when the row count is the same at all four stages, so nothing was lost on the way.
			VAR Source = [Source Rows]
			RETURN IF ( Source > 0 && Source = [Arrived Rows] && Source = [Checked Rows] && Source = [Summarised Rows], 1, 0 )
		formatString: #,0
		displayFolder: Latest run
		lineageTag: f54e8120-3feb-4dbf-adcd-395eb591ef69

	/// Rules that passed at the last check.
	measure 'Rules Pass' =
			// Rules that passed at the last check.
			CALCULATE ( COUNTROWS ( Rules ), REMOVEFILTERS ( Rules ), Rules[status] = "Pass" ) + 0
		formatString: #,0
		displayFolder: Latest run
		lineageTag: f0d5ba4b-f002-4733-93b8-43e101fc736b

	/// Rules that failed at the last check.
	measure 'Rules Fail' =
			// Rules that failed at the last check.
			CALCULATE ( COUNTROWS ( Rules ), REMOVEFILTERS ( Rules ), Rules[status] = "Fail" ) + 0
		formatString: #,0
		displayFolder: Latest run
		lineageTag: 20cab12a-fc0b-4598-b921-689679b232dd

	/// Rules that need a person to look, after the last check.
	measure 'Rules Review' =
			// Rules that need a person to look, after the last check.
			CALCULATE ( COUNTROWS ( Rules ), REMOVEFILTERS ( Rules ), Rules[status] = "For review" ) + 0
		formatString: #,0
		displayFolder: Latest run
		lineageTag: 2ec6219a-dadf-4966-8de9-ee5c352b2abd

	/// Rules that couldn't run at the last check. Never counted as a pass.
	measure 'Rules Not Checked' =
			// Rules that couldn't run at the last check. Never counted as a pass.
			CALCULATE ( COUNTROWS ( Rules ), REMOVEFILTERS ( Rules ), Rules[status] = "Not checked" ) + 0
		formatString: #,0
		displayFolder: Latest run
		lineageTag: 9e2c5bde-9ab5-4cf3-9478-a0c50baa0ab6

	/// Rules that found nothing to check at the last check. Never counted as a pass.
	measure 'Rules No Data' =
			// Rules that found nothing to check at the last check. Never counted as a pass.
			CALCULATE ( COUNTROWS ( Rules ), REMOVEFILTERS ( Rules ), Rules[status] = "No data" ) + 0
		formatString: #,0
		displayFolder: Latest run
		lineageTag: cd36918b-e3d1-4010-8540-82e68cf9c7bd

	/// All the rules in the register.
	measure 'Rules Total' =
			// All the rules in the register.
			CALCULATE ( COUNTROWS ( Rules ), REMOVEFILTERS ( Rules ) )
		formatString: #,0
		displayFolder: Latest run
		lineageTag: 1b134b41-356c-495f-9072-84b662221dfd

	/// Planted defects the rules caught at the last check.
	measure 'Planted Caught' =
			// Planted defects the rules caught at the last check.
			VAR Latest = [Latest Run No]
			RETURN CALCULATE ( MAX ( RunLog[planted_caught] ), REMOVEFILTERS ( RunLog ), RunLog[RunNo] = Latest )
		formatString: #,0
		displayFolder: Latest run
		lineageTag: 675ac308-8dc5-447b-8c04-002b67c0c17e

	/// Planted defects tried at the last check.
	measure 'Planted Tested' =
			// Planted defects tried at the last check.
			VAR Latest = [Latest Run No]
			RETURN CALCULATE ( MAX ( RunLog[planted_tested] ), REMOVEFILTERS ( RunLog ), RunLog[RunNo] = Latest )
		formatString: #,0
		displayFolder: Latest run
		lineageTag: 7c694b88-7aeb-4343-b7d6-f7ff502a0e2e

	/// How long the last check took.
	measure 'Run Seconds' =
			// How long the last check took.
			VAR Latest = [Latest Run No]
			RETURN CALCULATE ( MAX ( RunLog[seconds] ), REMOVEFILTERS ( RunLog ), RunLog[RunNo] = Latest )
		formatString: #,0
		displayFolder: Latest run
		lineageTag: 49776ae0-5f87-45a3-bcfb-bafb0b6c33d0

	/// Issues open at the last check. The engine opens and closes them by stated logic.
	measure 'Issues Open' =
			// Issues open at the last check. The engine opens and closes them by stated logic.
			CALCULATE ( COUNTROWS ( Issues ), REMOVEFILTERS ( Issues ), REMOVEFILTERS ( Rules ), Issues[state] = "Open" ) + 0
		formatString: #,0
		displayFolder: Latest run
		lineageTag: 9d34d6b7-5824-4b16-bae3-8f81229346e1

	/// Records that arrived since the last run.
	measure 'Records New' =
			// Records that arrived since the last run.
			VAR LastRun = CALCULATE ( MAX ( Ledger[run_id] ), REMOVEFILTERS ( Ledger ) )
			RETURN CALCULATE ( SUM ( Ledger[records_new] ), REMOVEFILTERS ( Ledger ), Ledger[run_id] = LastRun ) + 0
		formatString: #,0
		displayFolder: Latest run
		lineageTag: 10b9091c-02c3-4996-8932-58878fb22364

	/// Records whose contents changed since the last run. A change isn't an error: the publisher says records can change as quality assurance continues.
	measure 'Records Changed' =
			// Records whose contents changed since the last run. A change isn't an error: the publisher says records can change as quality assurance continues.
			VAR LastRun = CALCULATE ( MAX ( Ledger[run_id] ), REMOVEFILTERS ( Ledger ) )
			RETURN CALCULATE ( SUM ( Ledger[records_changed] ), REMOVEFILTERS ( Ledger ), Ledger[run_id] = LastRun ) + 0
		formatString: #,0
		displayFolder: Latest run
		lineageTag: b0a561c0-4baa-4f7c-9c0b-4e18597b71de

	/// Records gone since the last run, among months both runs cover.
	measure 'Records Removed' =
			// Records gone since the last run, among months both runs cover.
			VAR LastRun = CALCULATE ( MAX ( Ledger[run_id] ), REMOVEFILTERS ( Ledger ) )
			RETURN CALCULATE ( SUM ( Ledger[records_removed] ), REMOVEFILTERS ( Ledger ), Ledger[run_id] = LastRun ) + 0
		formatString: #,0
		displayFolder: Latest run
		lineageTag: e24769e3-d25d-4b7b-80c7-209f11ac946e

	/// How many verdicts, rules and publisher statements moved since the last run.
	measure 'Changes Count' =
			// How many verdicts, rules and publisher statements moved since the last run.
			COUNTROWS ( Changes ) + 0
		formatString: #,0
		displayFolder: Latest run
		lineageTag: ec3e7684-a466-4f5b-bb16-717d4f98cf61

	/// What moved since the last run, in words. Lists the first four, and says how many more.
	measure 'Changes Text' =
			// What moved since the last run, in words. Lists the first four, and says how many more.
			VAR Listed = TOPN ( 4, Changes, Changes[change_order], ASC )
			VAR Moved = COUNTROWS ( Changes ) + 0
			RETURN
			    IF (
			        Moved = 0,
			        IF ( [Run Count] <= 1, "This is the first run, so there's nothing to compare yet.", "No verdict or rule moved since the last run." ),
			        CONCATENATEX ( Listed, Changes[item] & ": " & Changes[before] & " to " & Changes[after], ".  ", Changes[change_order], ASC )
			            & IF ( Moved > 4, ".  And " & ( Moved - 4 ) & " more." )
			    )
		displayFolder: Latest run
		lineageTag: 242a9876-186a-4f32-8d07-f738b235ac4e

	/// What the change ledger found at the last comparison.
	measure 'Ledger Text' =
			// What the change ledger found at the last comparison.
			VAR Compared = CALCULATE ( MAX ( Ledger[run_id] ), REMOVEFILTERS ( Ledger ), Ledger[is_baseline] = FALSE (), Ledger[compared] = TRUE () )
			RETURN
			    IF (
			        ISBLANK ( Compared ),
			        "The first run set the baseline, so the ledger starts comparing at the next run.",
			        FORMAT ( [Records New], "#,0" ) & " new, " & FORMAT ( [Records Changed], "#,0" ) & " changed and " & FORMAT ( [Records Removed], "#,0" ) & " removed since the last run."
			    )
		displayFolder: Latest run
		lineageTag: 3bda85d7-3bdc-48a3-b3bb-86defedf5d06

	/// The decision picked; training an AI model when nothing is picked.
	measure 'Selected Use Id' =
			// The decision picked; training an AI model when nothing is picked.
			COALESCE ( SELECTEDVALUE ( Uses[use_id] ), "ai" )
		displayFolder: Trust
		lineageTag: 1005bf4c-3b02-4381-9a18-9797ea5ce9ab

	/// The name of the decision picked.
	measure 'Selected Use Name' =
			// The name of the decision picked.
			VAR Picked = [Selected Use Id]
			RETURN CALCULATE ( MAX ( Uses[use_name] ), REMOVEFILTERS ( Uses ), Uses[use_id] = Picked )
		displayFolder: Trust
		lineageTag: 2c7d16de-c6db-42ec-a9f0-32c8d4411d87

	/// 1 while the page still shows its starting example.
	measure 'Is Default Use' =
			// 1 while the page still shows its starting example.
			IF ( [Selected Use Id] = "ai", 1, 0 )
		formatString: #,0
		displayFolder: Trust
		lineageTag: 50c955fb-db44-48c4-8410-6a77c7b5f335

	/// What is selected, in large type at the top of the page. It names the first month with results, so it stays true as the window moves.
	measure 'Showing Trust' =
			// What is selected, in large type at the top of the page. It names the first month with results, so it stays true as the window moves.
			VAR StartMonth = MINX ( FILTER ( Months, Months[samples] > 0 ), Months[sample_month] )
			VAR StartDay = DATE ( VALUE ( LEFT ( StartMonth, 4 ) ), VALUE ( RIGHT ( StartMonth, 2 ) ), 1 )
			RETURN
			    [Selected Use Name] & "  ·  North West England  ·  " & FORMAT ( [Source Rows], "#,0" ) & " results since " & FORMAT ( StartDay, "mmm yyyy" )
		displayFolder: Trust
		lineageTag: b67314cb-5c57-4bd1-80c2-d1553b9a62ae

	/// The overall verdict for the decision picked.
	measure 'Selected Verdict' =
			// The overall verdict for the decision picked.
			VAR Picked = [Selected Use Id]
			RETURN CALCULATE ( MAX ( Verdicts[verdict] ), Verdicts[use_id] = Picked, Verdicts[dataset_id] = "overall" )
		displayFolder: Trust
		lineageTag: baffaa12-5b4f-4887-98ec-22bbeee3f1e6

	/// Distinct must-pass checks that failed for the decision picked. Rules about the pipeline apply to each dataset but count once here.
	measure 'Gates Failed' =
			// Distinct must-pass checks that failed for the decision picked. Rules about the pipeline apply to each dataset but count once here.
			VAR Picked = [Selected Use Id]
			RETURN CALCULATE ( DISTINCTCOUNT ( VerdictReasons[rule_id] ), VerdictReasons[use_id] = Picked, VerdictReasons[role] = "Gate", VerdictReasons[status] = "Fail" ) + 0
		formatString: #,0
		displayFolder: Trust
		lineageTag: f23b8480-adc4-463a-ab6d-a874f2bb9aeb

	/// Distinct must-pass checks that couldn't run or had no data for the decision picked.
	measure 'Gates Unchecked' =
			// Distinct must-pass checks that couldn't run or had no data for the decision picked.
			VAR Picked = [Selected Use Id]
			RETURN CALCULATE ( DISTINCTCOUNT ( VerdictReasons[rule_id] ), VerdictReasons[use_id] = Picked, VerdictReasons[role] = "Gate", VerdictReasons[status] IN { "Not checked", "No data" } ) + 0
		formatString: #,0
		displayFolder: Trust
		lineageTag: a9220aa7-a26f-4513-aaee-2bd99a0bfa7c

	/// Distinct rules that attach a condition to the decision picked.
	measure 'Conditions Open' =
			// Distinct rules that attach a condition to the decision picked.
			VAR Picked = [Selected Use Id]
			RETURN CALCULATE ( DISTINCTCOUNT ( VerdictReasons[rule_id] ), VerdictReasons[use_id] = Picked, VerdictReasons[matters] = TRUE (), NOT ( VerdictReasons[role] = "Gate" && VerdictReasons[status] IN { "Fail", "Not checked", "No data" } ) ) + 0
		formatString: #,0
		displayFolder: Trust
		lineageTag: 88628b65-cc8c-46e8-b158-937a37ee1e98

	/// One sentence that follows the verdict, so nobody has to work it out from counts.
	measure 'Selected Verdict Text' =
			// One sentence that follows the verdict, so nobody has to work it out from counts.
			VAR Failed = [Gates Failed]
			VAR Unchecked = [Gates Unchecked]
			VAR OpenCount = [Conditions Open]
			VAR Picked = [Selected Use Name]
			VAR Verdict = [Selected Verdict]
			RETURN
			    SWITCH (
			        Verdict,
			        "Not fit", Picked & ": not fit. " & Failed & IF ( Failed = 1, " must-pass check fails", " must-pass checks fail" ) & ", and passing the others can't outvote that.",
			        "Not checked", Picked & ": not checked. " & Unchecked & IF ( Unchecked = 1, " must-pass check", " must-pass checks" ) & " couldn't be run, so nobody knows yet.",
			        "Fit with conditions", Picked & ": fit, if " & OpenCount & IF ( OpenCount = 1, " condition is", " conditions are" ) & " met. Every must-pass check passes.",
			        "Fit", Picked & ": fit. Everything it depends on passed.",
			        "There's no verdict yet."
			    )
		displayFolder: Trust
		lineageTag: d8353d14-d61f-4cd2-8c96-a3852f9a536d

	/// The page's answer in one sentence, built from the verdicts at the last check. No figure is hard-coded. It ignores the row it is shown on, as the board has one row per cell.
	measure Headline =
			// The page's answer in one sentence, built from the verdicts at the last check. No figure is hard-coded. It ignores the row it is shown on, as the board has one row per cell.
			VAR Overall = CALCULATETABLE ( Verdicts, REMOVEFILTERS ( Verdicts ), Verdicts[dataset_id] = "overall" )
			VAR FitList = CONCATENATEX ( FILTER ( Overall, Verdicts[verdict] = "Fit" ), Verdicts[use_phrase], " and ", Verdicts[use_order], ASC )
			VAR CondList = CONCATENATEX ( FILTER ( Overall, Verdicts[verdict] = "Fit with conditions" ), Verdicts[use_phrase], " and ", Verdicts[use_order], ASC )
			VAR NotFitList = CONCATENATEX ( FILTER ( Overall, Verdicts[verdict] = "Not fit" ), Verdicts[use_phrase], " and ", Verdicts[use_order], ASC )
			VAR NotCheckedList = CONCATENATEX ( FILTER ( Overall, Verdicts[verdict] = "Not checked" ), Verdicts[use_phrase], " and ", Verdicts[use_order], ASC )
			VAR Parts =
			    IF ( FitList <> "", "fit for " & FitList & ", " )
			        & IF ( CondList <> "", "fit with conditions for " & CondList & ", " )
			        & IF ( NotFitList <> "", "not fit for " & NotFitList & ", " )
			        & IF ( NotCheckedList <> "", "not checked for " & NotCheckedList & ", " )
			RETURN IF ( Parts = "", "There's no verdict yet.", "At the last check, this data is " & LEFT ( Parts, LEN ( Parts ) - 2 ) & "." )
		displayFolder: Trust
		lineageTag: a11e08cc-80b5-4614-be8d-4e4998072481

	/// The rule's outcome for the decision shown, only when it holds that decision back. Everything in the reasons table reads this.
	measure 'Reason Status' =
			// The rule's outcome for the decision shown, only when it holds that decision back. Everything in the reasons table reads this.
			VAR Picked = [Selected Use Id]
			RETURN CALCULATE ( MAX ( VerdictReasons[status] ), VerdictReasons[use_id] = Picked, VerdictReasons[matters] = TRUE () )
		displayFolder: Trust
		lineageTag: defa873e-05f3-432b-a710-4bb47167e59a

	/// The outcome as a sign and a word, so colour is never the only cue. These signs sort fails first, then not checked, then for review.
	measure 'Reason Sign' =
			// The outcome as a sign and a word, so colour is never the only cue. These signs sort fails first, then not checked, then for review.
			VAR Outcome = [Reason Status]
			RETURN
			    SWITCH ( Outcome, "Pass", "✓ Pass", "Fail", "✗ Fail", "For review", "! For review", "Not checked", "– Not checked", "No data", "– No data" )
		displayFolder: Trust
		lineageTag: b645c13e-f342-4144-ae3c-c82669688c56

	/// What the rule is to this decision, in plain words. Blank for rules not holding it back, which removes them from the table.
	measure 'Reason Part' =
			// What the rule is to this decision, in plain words. Blank for rules not holding it back, which removes them from the table.
			VAR Picked = [Selected Use Id]
			VAR IsGate = CALCULATE ( COUNTROWS ( VerdictReasons ), VerdictReasons[use_id] = Picked, VerdictReasons[matters] = TRUE (), VerdictReasons[role] = "Gate" )
			RETURN IF ( NOT ISBLANK ( [Reason Status] ), IF ( IsGate > 0, "Must pass", "Condition" ) )
		displayFolder: Trust
		lineageTag: d519d6d5-74a3-43c7-9e67-e49b4d1b6300

	/// What a person needs to do about this rule, for the decision shown.
	measure 'Reason Needed' =
			// What a person needs to do about this rule, for the decision shown.
			VAR Picked = [Selected Use Id]
			RETURN CALCULATE ( MAX ( VerdictReasons[condition] ), VerdictReasons[use_id] = Picked, VerdictReasons[matters] = TRUE () )
		displayFolder: Trust
		lineageTag: 4e32ff1c-1a2d-4db3-b68f-c3cd0a0008c1

	/// Rows lost between the source and the report. Should be nothing.
	measure 'Lineage Lost Rows' =
			// Rows lost between the source and the report. Should be nothing.
			[Source Rows] - [Summarised Rows]
		formatString: #,0
		displayFolder: How it works
		lineageTag: 449ddb5a-c1c6-42b4-9b94-0ab377fe7b7a

	/// The planted defect result, in a sentence.
	measure 'Planted Text' =
			// The planted defect result, in a sentence.
			FORMAT ( [Planted Caught], "0" ) & " of " & FORMAT ( [Planted Tested], "0" ) & " planted defects were caught. A rule that misses its own defect fails CHK-01, which every decision must pass. The defects only ever go into a private copy, and the source data is never changed."
		displayFolder: How it works
		lineageTag: 45ed9850-65ea-44e0-80b3-d9aca6d10409

	/// Each publisher statement at the last check, with a sign and a word. A change is a prompt to look, not a fault.
	measure 'Watch Sign' =
			// Each publisher statement at the last check, with a sign and a word. A change is a prompt to look, not a fault.
			VAR Outcome = SELECTEDVALUE ( SourceWatch[status] )
			VAR PrintBefore = SELECTEDVALUE ( SourceWatch[previous_fingerprint] )
			VAR PrintLatest = SELECTEDVALUE ( SourceWatch[fingerprint] )
			RETURN
			    SWITCH (
			        TRUE (),
			        Outcome <> "ok", "– Couldn't be read",
			        PrintBefore = "", "✓ Read, first look",
			        PrintBefore <> PrintLatest, "! Changed: please look",
			        "✓ Read, unchanged"
			    )
		displayFolder: How it works
		lineageTag: 7daf11ca-17e9-489b-8760-c4ae0a7d60d9

	/// How many records the ledger is tracking.
	measure 'Fingerprints Text' =
			// How many records the ledger is tracking.
			VAR LastRun = CALCULATE ( MAX ( Ledger[run_id] ), REMOVEFILTERS ( Ledger ) )
			VAR Tracked = CALCULATE ( MAX ( Ledger[records_now] ), REMOVEFILTERS ( Ledger ), Ledger[run_id] = LastRun )
			RETURN FORMAT ( Tracked, "#,0" ) & " records fingerprinted at the last run."
		displayFolder: How it works
		lineageTag: cfdfcb1c-c5f9-4959-9e1e-102242b7c2bf

	/// Says plainly whether the second service was read live, or stood in for by a saved copy.
	measure 'Bathing Source Text' =
			// Says plainly whether the second service was read live, or stood in for by a saved copy.
			VAR Latest = [Latest Run No]
			VAR State = CALCULATE ( MAX ( RunLog[bathing_status] ), REMOVEFILTERS ( RunLog ), RunLog[RunNo] = Latest )
			VAR Taken = CALCULATE ( MAX ( Manifest[taken_on] ), Manifest[source] = "bathing" )
			RETURN
			    SWITCH (
			        State,
			        "ok", "The bathing water service was read live at the last check.",
			        "copy", "The bathing water service doesn't accept requests from the server that runs the nightly check, so a copy taken on " & FORMAT ( Taken, "d mmm yyyy" ) & " stands in. A rule says when it's out of date.",
			        "The bathing water service couldn't be read at the last check, and its rules show Not checked."
			    )
		displayFolder: How it works
		lineageTag: 43dfcb1c-35f1-4e0b-929d-b921f4302968

	/// The licence statements as read at the last check, with a polite note when they differ.
	measure 'Licence Text' =
			// The licence statements as read at the last check, with a polite note when they differ.
			VAR Different = CALCULATE ( COUNTROWS ( SourceWatch ), SourceWatch[kind] = "licence", SourceWatch[status] = "ok", SourceWatch[value] <> "Open Government Licence" )
			RETURN
			    IF (
			        Different > 0,
			        "The service's own pages state the Open Government Licence v3.0, which this report relies on. Its catalogue record reads differently, so that's recorded as a question for a steward.",
			        "The statements read at the last check agree on the Open Government Licence v3.0."
			    )
		displayFolder: How it works
		lineageTag: 312544ea-e826-4cc3-94fe-8b1b87d9f7a7

	/// What was measured, as its code; ammonia when nothing is picked.
	measure 'Selected Det Code' =
			// What was measured, as its code; ammonia when nothing is picked.
			COALESCE ( SELECTEDVALUE ( PickMeasured[det_code] ), "0111" )
		displayFolder: Same data
		lineageTag: 9a86c0df-28d3-40ec-abc8-a2e76369b265

	/// What was measured, in words.
	measure 'Selected Det Name' =
			// What was measured, in words.
			VAR Code = [Selected Det Code]
			RETURN CALCULATE ( MAX ( PickMeasured[det_name] ), REMOVEFILTERS ( PickMeasured ), PickMeasured[det_code] = Code )
		displayFolder: Same data
		lineageTag: 4223f8cc-785e-46cf-89f9-f2f791425546

	/// The unit of what was measured.
	measure 'Selected Unit' =
