	/// The finding as a plain comparison, built from the two figures. It follows the direction of the difference.
	measure 'Same Data Headline' =
			// The finding as a plain comparison, built from the two figures. It follows the direction of the difference.
			VAR Quick = [Region Quick]
			VAR Yours = [Region Yours]
			VAR Unit = [Selected Unit]
			VAR TopQuick = [Quick Top Area]
			VAR TopYours = [Your Top Area]
			VAR Times = IF ( Quick > 0 && Yours > 0, MAX ( Quick, Yours ) / MIN ( Quick, Yours ) )
			RETURN
			    IF (
			        ISBLANK ( Quick ) || ISBLANK ( Yours ),
			        "There's no figure for this combination.",
			        "The quick way gives " & FORMAT ( Quick, "0.00" ) & " " & Unit & " for the North West. Your way gives " & FORMAT ( Yours, "0.00" ) & " " & Unit
			            & IF ( Times >= 1.05, ", about " & FORMAT ( Times, IF ( Times >= 10, "0", "0.0" ) ) & " times " & IF ( Yours < Quick, "lower", "higher" ) )
			            & ". "
			            & IF ( TopQuick <> TopYours, "The highest sub-area changes from " & TopQuick & " to " & TopYours & ".", "The highest sub-area stays " & TopYours & "." )
			    )
		displayFolder: Same data
		lineageTag: 68b100a1-ee2e-4d49-ba3f-28d79cce7bf9

	/// What is selected, in large type at the top of the page.
	measure 'Showing Same Data' =
			// What is selected, in large type at the top of the page.
			[Selected Det Name] & " in rivers  ·  " & COALESCE ( SELECTEDVALUE ( PickMethod[Below-limit results] ), "Count at half the limit" ) & "  ·  " & COALESCE ( SELECTEDVALUE ( PickSamples[Samples] ), "Routine samples only" ) & "  ·  " & COALESCE ( SELECTEDVALUE ( PickMonths[Months] ), "Complete months only" ) & "  ·  " & COALESCE ( SELECTEDVALUE ( PickStatistic[Statistic] ), "Average" )
		displayFolder: Same data
		lineageTag: 37d77665-540e-4e25-a531-682c10708a43

	/// 1 while the page still shows its starting example.
	measure 'Is Default Same Data' =
			// 1 while the page still shows its starting example.
			IF ( [Your Key] = "0111|Half the limit|Routine samples|Complete months|Average", 1, 0 )
		formatString: #,0
		displayFolder: Same data
		lineageTag: 50a148eb-592d-4467-a60f-6c10012a5a85

	/// The North West's figure with one switch changed from the quick way.
	measure 'Switch Figure' =
			// The North West's figure with one switch changed from the quick way.
			VAR Code = [Selected Det Code]
			VAR KeyNow = Code & "|" & SELECTEDVALUE ( SwitchEffects[Method] ) & "|" & SELECTEDVALUE ( SwitchEffects[SampleSet] ) & "|" & SELECTEDVALUE ( SwitchEffects[MonthSet] ) & "|" & SELECTEDVALUE ( SwitchEffects[StatKey] )
			RETURN CALCULATE ( MAX ( SameData[figure] ), REMOVEFILTERS ( SameData ), SameData[scenario_key] = KeyNow, SameData[sub_area] = "North West" )
		formatString: 0.00
		displayFolder: Same data
		lineageTag: 65feb0d9-b98e-4b65-ad5c-b600ee3fa3cc

	/// The quick way's figure, repeated on each row of the switch chart, so bars can start from it.
	measure 'Switch Base' =
			// The quick way's figure, repeated on each row of the switch chart, so bars can start from it.
			[Region Quick]
		formatString: 0.00
		displayFolder: Same data
		lineageTag: 694ac933-bc90-415e-8aab-11281a1c5fda

	/// The rule picked, or blank when several are in view. The chart uses it to highlight a row.
	measure 'Selected Rule Id' =
			// The rule picked, or blank when several are in view. The chart uses it to highlight a row.
			SELECTEDVALUE ( Rules[id] )
		displayFolder: Rules
		lineageTag: 8bd33ba3-6e1c-4a71-b04e-5fca4ef0ef53

	/// The rule's result in one sentence, using the true number of failed records.
	measure 'Rule Card Text' =
			// The rule's result in one sentence, using the true number of failed records. Small shares keep extra decimals so they don't read as nothing.
			VAR Outcome = SELECTEDVALUE ( Rules[status] )
			VAR Failed = SUM ( Rules[failed] )
			VAR Checked = SUM ( Rules[eligible] )
			VAR ShareFailed = SUM ( Rules[failed_pct] )
			RETURN
			    SWITCH (
			        Outcome,
			        "Not checked", "This rule couldn't run at the last check. " & SELECTEDVALUE ( Rules[note] ),
			        "No data", "There was nothing for this rule to check.",
			        BLANK (), "Pick a rule to see its result.",
			        FORMAT ( Failed, "#,0" ) & " of " & FORMAT ( Checked, "#,0" ) & " records (" & FORMAT ( ShareFailed, IF ( ShareFailed >= 1, "0.0", "0.0##" ) ) & "%) break this rule."
			    )
		displayFolder: Rules
		lineageTag: a220afb3-8d64-4293-a56e-aeca2cc45440

	/// The rule's stated tolerance. Thresholds are illustrative.
	measure 'Rule Threshold Text' =
			// The rule's stated tolerance, in plain words. Thresholds are illustrative. Joining a number to text keeps it plain, with no stray decimal point.
			VAR FailAbove = SELECTEDVALUE ( Rules[fail_above] )
			VAR ReviewAbove = SELECTEDVALUE ( Rules[review_above] )
			RETURN
			    IF ( NOT ISBLANK ( FailAbove ), IF ( FailAbove = 0, "Any break fails it", "Fails above " & FailAbove & "%" ), "Never fails outright" )
			        & IF ( NOT ISBLANK ( ReviewAbove ) && ( ISBLANK ( FailAbove ) || ReviewAbove < FailAbove ), ". Needs review above " & ReviewAbove & "%" )
			        & ". Illustrative."
		displayFolder: Rules
		lineageTag: a80b2d38-8959-4acc-ad1b-e95cdc92b1fb

	/// Whether this rule's problem changes the answer, with the two figures. Says so plainly when no effect was measured.
	measure 'Rule Effect Text' =
			// Whether this rule's problem changes the answer, with the two figures. Says so plainly when no effect was measured. Whole numbers are shown without a stray decimal point.
			VAR Measured = SELECTEDVALUE ( Rules[measured] )
			VAR Careful = SUM ( Rules[careful] )
			VAR Careless = SUM ( Rules[careless] )
			VAR Effect = SUM ( Rules[effect_pct] )
			VAR Unit = SELECTEDVALUE ( Rules[unit] )
			VAR CarefulText = FORMAT ( Careful, IF ( ROUND ( Careful, 2 ) = ROUND ( Careful, 0 ), "#,0", "#,0.00" ) )
			VAR CarelessText = FORMAT ( Careless, IF ( ROUND ( Careless, 2 ) = ROUND ( Careless, 0 ), "#,0", "#,0.00" ) )
			RETURN
			    IF (
			        Measured = TRUE (),
			        SELECTEDVALUE ( Rules[figure] ) & ": " & CarefulText & " worked out carefully, " & CarelessText & " carelessly"
			            & IF ( Unit <> "", " (" & Unit & ")" )
			            & IF ( NOT ISBLANK ( Effect ), ". That moves it by " & FORMAT ( Effect, "+#,0.0;-#,0.0" ) & "%." , "." ),
			        "No effect on a figure was measured for this rule."
			    )
		displayFolder: Rules
		lineageTag: b4ebd32a-cbd2-48a6-bcf7-14742be8550a

	/// Whether the rule caught its planted defect at the last check.
	measure 'Rule Test Text' =
			// Whether the rule caught its planted defect at the last check.
			VAR Outcome = SELECTEDVALUE ( Rules[test_outcome] )
			VAR CountBefore = SUM ( Rules[test_failed_before] )
			VAR CountAfter = SUM ( Rules[test_failed_after] )
			RETURN
			    SWITCH (
			        Outcome,
			        "Caught", "Caught at the last check: its count rose from " & FORMAT ( CountBefore, "#,0" ) & " to " & FORMAT ( CountAfter, "#,0" ) & " when its own defect was planted in a private copy.",
			        "Missed", "Missed at the last check: this rule didn't notice its own planted defect.",
			        "Proved by its own test", "This rule checks the others. A separate test proves it fails when a rule misses.",
			        "Not checked", "Not tested at the last check, because the rule couldn't run.",
			        "Not tested at the last check."
			    )
		displayFolder: Rules
		lineageTag: 0584b049-982b-45f7-93c0-e8babee6513c

	/// What is selected, in large type at the top of the page.
	measure 'Showing Rules' =
			// What is selected, in large type at the top of the page.
			COALESCE ( SELECTEDVALUE ( Rules[rule_label] ), "Every rule" ) & "  ·  " & [Rules Total] & " rules run every night"
		displayFolder: Rules
		lineageTag: 28187fa2-66ca-4682-bcc7-078da0e321f9

	/// What is selected, in large type at the top of the exceptions page.
	measure 'Showing Exceptions' =
			// What is selected, in large type at the top of the exceptions page.
			COALESCE ( SELECTEDVALUE ( Rules[rule_label] ), "Pick a rule" ) & IF ( ISFILTERED ( Exceptions[month_label] ), "  ·  " & SELECTEDVALUE ( Exceptions[month_label] ) )
		displayFolder: Rules
		lineageTag: 9695847d-3555-4584-8db4-417ff6e5ec7c

	/// 1 while the page still shows its starting example.
	measure 'Is Default Rule' =
			// 1 while the page still shows its starting example.
			IF ( SELECTEDVALUE ( Rules[id] ) = "VAL-07", 1, 0 )
		formatString: #,0
		displayFolder: Rules
		lineageTag: 1792d4e5-3b71-46df-9293-cb979e5b540d

	/// Failed records listed for what is picked.
	measure 'Exceptions Shown' =
			// Failed records listed for what is picked.
			COUNTROWS ( Exceptions ) + 0
		formatString: #,0
		displayFolder: Rules
		lineageTag: ba2cd959-1bb3-40d6-ab71-9280cfa1571d

	/// States the true total beside the rows shown, so nobody takes a capped list for the whole story.
	measure 'Exceptions Text' =
			// States the true total beside the rows shown, so nobody takes a capped list for the whole story.
			VAR Shown = [Exceptions Shown]
			VAR TrueTotal = SUM ( Rules[failed] )
			VAR Picked = SELECTEDVALUE ( Rules[id] )
			VAR MonthPicked = ISFILTERED ( Exceptions[month_label] )
			RETURN
			    IF (
			        ISBLANK ( Picked ),
			        "Pick a rule to see its failed records.",
			        IF (
			            TrueTotal = 0,
			            "Nothing failed this rule at the last check.",
			            IF (
			                MonthPicked,
			                "Showing " & FORMAT ( Shown, "#,0" ) & " listed records for that month. This rule has " & FORMAT ( TrueTotal, "#,0" ) & " in all.",
			                IF (
			                    Shown < TrueTotal,
			                    "Showing the newest " & FORMAT ( Shown, "#,0" ) & " of " & FORMAT ( TrueTotal, "#,0" ) & " failed records. The count comes from the check itself, and only the listing is capped.",
			                    "Showing all " & FORMAT ( TrueTotal, "#,0" ) & " failed records."
			                )
			            )
			        )
			    )
		displayFolder: Rules
		lineageTag: 19e828a7-4e5c-41e0-8988-85401ac13d16

	/// The rule a listed record broke, shown on each row. It's blank for records of other rules, which keeps the list to the rule picked.
	measure 'Exception Rule' =
			// The rule a listed record broke, shown on each row. It's blank for records of other rules, which keeps the list to the rule picked.
			IF ( COUNTROWS ( Exceptions ) > 0, SELECTEDVALUE ( Rules[id] ) )
		displayFolder: Rules
		lineageTag: 1f1b2306-d759-4ec9-b8bd-bff44f149a20

	column Placeholder
		isHidden
		isNameInferred
		sourceColumn: [Placeholder]

	partition 'Report Measures' = calculated
		mode: import
		source =
				// Holds every measure. It has one hidden placeholder column, because a table must have a column.
				ROW ( "Placeholder", 0 )

