	/// Finds the scenario the pickers describe. Defaults are the stated method: half the limit, routine samples, complete months, average.
	measure 'Your Key' =
			// Finds the scenario the pickers describe. Defaults are the stated method: half the limit, routine samples, complete months, average.
			[Selected Det Code] & "|" & COALESCE ( SELECTEDVALUE ( PickMethod[Method] ), "Half the limit" ) & "|" & COALESCE ( SELECTEDVALUE ( PickSamples[SampleSet] ), "Routine samples" ) & "|" & COALESCE ( SELECTEDVALUE ( PickMonths[MonthSet] ), "Complete months" ) & "|" & COALESCE ( SELECTEDVALUE ( PickStatistic[StatKey] ), "Average" )
		displayFolder: Same data
		lineageTag: 93a497dd-b27e-4cbd-9b8e-ae9a36053fdb

	/// The quick way: drop below-limit results, use every sample and month, take a plain average.
	measure 'Quick Key' =
			// The quick way: drop below-limit results, use every sample and month, take a plain average.
			[Selected Det Code] & "|Dropped|All samples|All months|Average"
		displayFolder: Same data
		lineageTag: 538600d9-557e-4cfd-94e7-2e7ab525668f

	/// One sub-area's figure the quick way. Only ranked sub-areas have one.
	measure 'Quick Figure' =
			// One sub-area's figure the quick way. Only ranked sub-areas have one.
			VAR AreaNow = SELECTEDVALUE ( RankedAreas[area_name] )
			VAR KeyNow = [Quick Key]
			RETURN CALCULATE ( MAX ( SameData[figure] ), SameData[scenario_key] = KeyNow, SameData[area_name] = AreaNow )
		formatString: 0.00
		displayFolder: Same data
		lineageTag: df85c382-b33a-4db4-bd95-c42b539f8c74

	/// Where the quick way places one sub-area. 1 is the highest figure. This describes the calculation, not whose water is better.
	measure 'Quick Rank' =
			// Where the quick way places one sub-area. 1 is the highest figure. This describes the calculation, not whose water is better.
			VAR AreaNow = SELECTEDVALUE ( RankedAreas[area_name] )
			VAR KeyNow = [Quick Key]
			RETURN CALCULATE ( MAX ( SameData[area_rank] ), SameData[scenario_key] = KeyNow, SameData[area_name] = AreaNow )
		formatString: #,0
		displayFolder: Same data
		lineageTag: 93f950ee-f4c8-4e3f-9407-7aa159716dbe

	/// One sub-area's figure, the way the pickers say.
	measure 'Your Figure' =
