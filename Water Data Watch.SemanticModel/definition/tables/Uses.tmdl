/// The decisions the data might feed.
table Uses
	lineageTag: 2fbd4c39-9932-48b3-970f-fc94c30675b2

	column use_id
		dataType: string
		isHidden
		lineageTag: 742411c4-f784-4d72-ac63-fde090f52f2a
		summarizeBy: none
		sourceColumn: use_id

	column use_order
		dataType: int64
		isHidden
		formatString: #,0
		lineageTag: ff7305e2-e7b7-4fb0-bdae-d69afb2f6e97
		summarizeBy: none
		sourceColumn: use_order

	column use_name
		dataType: string
		lineageTag: 72769365-1540-40ac-bd28-e3af09774461
		summarizeBy: none
		sourceColumn: use_name
		sortByColumn: use_order

	column question
		dataType: string
		lineageTag: 6dcfe07d-a758-494b-9567-2d4561c71098
		summarizeBy: none
		sourceColumn: question

	column needs
		dataType: string
		lineageTag: 59c622fc-31e0-4782-8e04-5fb74570cc0c
		summarizeBy: none
		sourceColumn: needs

	partition Uses = m
		mode: import
		queryGroup: Model
		source =
				// The decisions the data might feed.
				let
				    // Read the file from the data branch
				    Source = fnRepoCsv("uses.csv"),
				    // Give every column its type. en-US means numbers use a dot, and dates are read as written, year first
				    Typed = Table.TransformColumnTypes(Source, {{"use_id", type text}, {"use_order", Int64.Type}, {"use_name", type text}, {"question", type text}, {"needs", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

