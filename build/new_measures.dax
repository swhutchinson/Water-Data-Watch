-- Water Data Watch: every measure, in the order they are created through the Power BI modeling MCP.
-- This file is the readable source of truth; Desktop writes the same DAX into the TMDL when Sam saves.
-- Format: "MEASURE 'Report Measures'[Name] =", then "-- folder:" and "-- desc:" lines, then the DAX.
-- "Now" is always RefreshInfo, never NOW(). Reserved VAR names (Count, Top, Name, Status, Rows, Rank) are avoided.

-- ============================== The latest run ==============================
MEASURE 'Report Measures'[Latest Run No] =
-- folder: Latest run
-- desc: The number of the newest run in the log, which every "at the last check" figure reads.
CALCULATE ( MAX ( RunLog[RunNo] ), REMOVEFILTERS ( RunLog ) )

MEASURE 'Report Measures'[Run Count] =
-- folder: Latest run
-- desc: How many runs the log holds.
CALCULATE ( COUNTROWS ( RunLog ), REMOVEFILTERS ( RunLog ) )

MEASURE 'Report Measures'[Tracking Since] =
-- folder: Latest run
-- desc: The date of the first run. Nothing the engine measures goes back further.
CALCULATE ( MIN ( RunLog[as_of] ), REMOVEFILTERS ( RunLog ) )

MEASURE 'Report Measures'[Days Tracked] =
-- folder: Latest run
-- desc: Days since tracking began, counting the first day, measured to the last refresh.
VAR Since = [Tracking Since]
VAR RefreshDay = MAX ( RefreshInfo[RefreshedUKDate] )
RETURN IF ( NOT ISBLANK ( Since ), DATEDIFF ( Since, RefreshDay, DAY ) + 1 )

MEASURE 'Report Measures'[Tracking Text] =
-- folder: Latest run
-- desc: States when tracking began, because trends and histories can only go back that far.
VAR Days = [Days Tracked]
RETURN
    "Tracking since " & FORMAT ( [Tracking Since], "d mmm yyyy" )
        & IF ( Days = 1, " (day 1)", " (" & FORMAT ( Days, "#,0" ) & " days)" )

MEASURE 'Report Measures'[Last Check Text] =
-- folder: Latest run
-- desc: When the newest run finished, in UK time.
VAR Latest = [Latest Run No]
RETURN CALCULATE ( MAX ( RunLog[RunUKText] ), REMOVEFILTERS ( RunLog ), RunLog[RunNo] = Latest )

MEASURE 'Report Measures'[Hours Since Check] =
-- folder: Latest run
-- desc: Hours between the newest run finishing and the last refresh. The refresh time is the report's only "now".
VAR Latest = [Latest Run No]
VAR RunTime = CALCULATE ( MAX ( RunLog[RunUTC] ), REMOVEFILTERS ( RunLog ), RunLog[RunNo] = Latest )
VAR RefreshTime = MAX ( RefreshInfo[RefreshedUTC] )
RETURN IF ( NOT ISBLANK ( RunTime ), DATEDIFF ( RunTime, RefreshTime, HOUR ) )

MEASURE 'Report Measures'[Stale Warning] =
-- folder: Latest run
-- desc: A warning once the newest run is over 36 hours old. GitHub can start a nightly run hours late, so a day alone isn't a problem.
VAR Hours = [Hours Since Check]
RETURN IF ( Hours > 36, "The last check is " & FORMAT ( ROUNDDOWN ( Hours / 24, 0 ), "0" ) & " days old", "" )

MEASURE 'Report Measures'[Freshness Text] =
-- folder: Latest run
-- desc: The header's freshness line: last check, tracking start and any warning.
VAR Warning = [Stale Warning]
RETURN
    "Last check " & [Last Check Text] & "  ·  " & [Tracking Text]
        & IF ( Warning <> "", "  ·  " & Warning )

MEASURE 'Report Measures'[Source Rows] =
-- folder: Latest run
-- desc: Rows the source says it holds.
CALCULATE ( SUM ( ControlTotals[row_count] ), ControlTotals[stage_no] = 1 )

MEASURE 'Report Measures'[Arrived Rows] =
-- folder: Latest run
-- desc: Rows that arrived.
CALCULATE ( SUM ( ControlTotals[row_count] ), ControlTotals[stage_no] = 2 )

MEASURE 'Report Measures'[Checked Rows] =
-- folder: Latest run
-- desc: Rows the rules checked.
CALCULATE ( SUM ( ControlTotals[row_count] ), ControlTotals[stage_no] = 3 )

MEASURE 'Report Measures'[Summarised Rows] =
-- folder: Latest run
-- desc: Rows the report's summaries add up to.
CALCULATE ( SUM ( ControlTotals[row_count] ), ControlTotals[stage_no] = 4 )

MEASURE 'Report Measures'[Totals Agree] =
-- folder: Latest run
-- desc: 1 when the row count is the same at all four stages, so nothing was lost on the way.
VAR Source = [Source Rows]
RETURN IF ( Source > 0 && Source = [Arrived Rows] && Source = [Checked Rows] && Source = [Summarised Rows], 1, 0 )

MEASURE 'Report Measures'[Rules Pass] =
-- folder: Latest run
-- desc: Rules that passed at the last check.
CALCULATE ( COUNTROWS ( Rules ), REMOVEFILTERS ( Rules ), Rules[status] = "Pass" ) + 0

MEASURE 'Report Measures'[Rules Fail] =
-- folder: Latest run
-- desc: Rules that failed at the last check.
CALCULATE ( COUNTROWS ( Rules ), REMOVEFILTERS ( Rules ), Rules[status] = "Fail" ) + 0

MEASURE 'Report Measures'[Rules Review] =
-- folder: Latest run
-- desc: Rules that need a person to look, after the last check.
CALCULATE ( COUNTROWS ( Rules ), REMOVEFILTERS ( Rules ), Rules[status] = "For review" ) + 0

MEASURE 'Report Measures'[Rules Not Checked] =
-- folder: Latest run
-- desc: Rules that couldn't run at the last check. Never counted as a pass.
CALCULATE ( COUNTROWS ( Rules ), REMOVEFILTERS ( Rules ), Rules[status] = "Not checked" ) + 0

MEASURE 'Report Measures'[Rules No Data] =
-- folder: Latest run
-- desc: Rules that found nothing to check at the last check. Never counted as a pass.
CALCULATE ( COUNTROWS ( Rules ), REMOVEFILTERS ( Rules ), Rules[status] = "No data" ) + 0

MEASURE 'Report Measures'[Rules Total] =
-- folder: Latest run
-- desc: All the rules in the register.
CALCULATE ( COUNTROWS ( Rules ), REMOVEFILTERS ( Rules ) )

MEASURE 'Report Measures'[Planted Caught] =
-- folder: Latest run
-- desc: Planted defects the rules caught at the last check.
VAR Latest = [Latest Run No]
RETURN CALCULATE ( MAX ( RunLog[planted_caught] ), REMOVEFILTERS ( RunLog ), RunLog[RunNo] = Latest )

MEASURE 'Report Measures'[Planted Tested] =
-- folder: Latest run
-- desc: Planted defects tried at the last check.
VAR Latest = [Latest Run No]
RETURN CALCULATE ( MAX ( RunLog[planted_tested] ), REMOVEFILTERS ( RunLog ), RunLog[RunNo] = Latest )

MEASURE 'Report Measures'[Run Seconds] =
-- folder: Latest run
-- desc: How long the last check took.
VAR Latest = [Latest Run No]
RETURN CALCULATE ( MAX ( RunLog[seconds] ), REMOVEFILTERS ( RunLog ), RunLog[RunNo] = Latest )

MEASURE 'Report Measures'[Issues Open] =
-- folder: Latest run
-- desc: Issues open at the last check. The engine opens and closes them by stated logic.
CALCULATE ( COUNTROWS ( Issues ), REMOVEFILTERS ( Issues ), REMOVEFILTERS ( Rules ), Issues[state] = "Open" ) + 0

MEASURE 'Report Measures'[Records New] =
-- folder: Latest run
-- desc: Records that arrived since the last run.
VAR LastRun = CALCULATE ( MAX ( Ledger[run_id] ), REMOVEFILTERS ( Ledger ) )
RETURN CALCULATE ( SUM ( Ledger[records_new] ), REMOVEFILTERS ( Ledger ), Ledger[run_id] = LastRun ) + 0

MEASURE 'Report Measures'[Records Changed] =
-- folder: Latest run
-- desc: Records whose contents changed since the last run. A change isn't an error: the publisher says records can change as quality assurance continues.
VAR LastRun = CALCULATE ( MAX ( Ledger[run_id] ), REMOVEFILTERS ( Ledger ) )
RETURN CALCULATE ( SUM ( Ledger[records_changed] ), REMOVEFILTERS ( Ledger ), Ledger[run_id] = LastRun ) + 0

MEASURE 'Report Measures'[Records Removed] =
-- folder: Latest run
-- desc: Records gone since the last run, among months both runs cover.
VAR LastRun = CALCULATE ( MAX ( Ledger[run_id] ), REMOVEFILTERS ( Ledger ) )
RETURN CALCULATE ( SUM ( Ledger[records_removed] ), REMOVEFILTERS ( Ledger ), Ledger[run_id] = LastRun ) + 0

MEASURE 'Report Measures'[Changes Count] =
-- folder: Latest run
-- desc: How many verdicts, rules and publisher statements moved since the last run.
COUNTROWS ( Changes ) + 0

MEASURE 'Report Measures'[Changes Text] =
-- folder: Latest run
-- desc: What moved since the last run, in words. Lists the first four, and says how many more.
VAR Listed = TOPN ( 4, Changes, Changes[change_order], ASC )
VAR Moved = COUNTROWS ( Changes ) + 0
RETURN
    IF (
        Moved = 0,
        IF ( [Run Count] <= 1, "This is the first run, so there's nothing to compare yet.", "No verdict or rule moved since the last run." ),
        CONCATENATEX ( Listed, Changes[item] & ": " & Changes[before] & " to " & Changes[after], ".  ", Changes[change_order], ASC )
            & IF ( Moved > 4, ".  And " & ( Moved - 4 ) & " more." )
    )

MEASURE 'Report Measures'[Ledger Text] =
-- folder: Latest run
-- desc: What the change ledger found at the last comparison.
VAR Compared = CALCULATE ( MAX ( Ledger[run_id] ), REMOVEFILTERS ( Ledger ), Ledger[is_baseline] = FALSE (), Ledger[compared] = TRUE () )
RETURN
    IF (
        ISBLANK ( Compared ),
        "The first run set the baseline, so the ledger starts comparing at the next run.",
        FORMAT ( [Records New], "#,0" ) & " new, " & FORMAT ( [Records Changed], "#,0" ) & " changed and " & FORMAT ( [Records Removed], "#,0" ) & " removed since the last run."
    )

-- ============================== Can I trust it? ==============================
MEASURE 'Report Measures'[Selected Use Id] =
-- folder: Trust
-- desc: The decision picked; training an AI model when nothing is picked.
COALESCE ( SELECTEDVALUE ( Uses[use_id] ), "ai" )

MEASURE 'Report Measures'[Selected Use Name] =
-- folder: Trust
-- desc: The name of the decision picked.
VAR Picked = [Selected Use Id]
RETURN CALCULATE ( MAX ( Uses[use_name] ), REMOVEFILTERS ( Uses ), Uses[use_id] = Picked )

MEASURE 'Report Measures'[Is Default Use] =
-- folder: Trust
-- desc: 1 while the page still shows its starting example.
IF ( [Selected Use Id] = "ai", 1, 0 )

MEASURE 'Report Measures'[Showing Trust] =
-- folder: Trust
-- desc: What is selected, in large type at the top of the page. It names the first month with results, so it stays true as the window moves.
VAR StartMonth = MINX ( FILTER ( Months, Months[samples] > 0 ), Months[sample_month] )
VAR StartDay = DATE ( VALUE ( LEFT ( StartMonth, 4 ) ), VALUE ( RIGHT ( StartMonth, 2 ) ), 1 )
RETURN
    [Selected Use Name] & "  ·  North West England  ·  " & FORMAT ( [Source Rows], "#,0" ) & " results since " & FORMAT ( StartDay, "mmm yyyy" )

MEASURE 'Report Measures'[Selected Verdict] =
-- folder: Trust
-- desc: The overall verdict for the decision picked.
VAR Picked = [Selected Use Id]
RETURN CALCULATE ( MAX ( Verdicts[verdict] ), Verdicts[use_id] = Picked, Verdicts[dataset_id] = "overall" )

MEASURE 'Report Measures'[Gates Failed] =
-- folder: Trust
-- desc: Distinct must-pass checks that failed for the decision picked. Rules about the pipeline apply to each dataset but count once here.
VAR Picked = [Selected Use Id]
RETURN CALCULATE ( DISTINCTCOUNT ( VerdictReasons[rule_id] ), VerdictReasons[use_id] = Picked, VerdictReasons[role] = "Gate", VerdictReasons[status] = "Fail" ) + 0

MEASURE 'Report Measures'[Gates Unchecked] =
-- folder: Trust
-- desc: Distinct must-pass checks that couldn't run or had no data for the decision picked.
VAR Picked = [Selected Use Id]
RETURN CALCULATE ( DISTINCTCOUNT ( VerdictReasons[rule_id] ), VerdictReasons[use_id] = Picked, VerdictReasons[role] = "Gate", VerdictReasons[status] IN { "Not checked", "No data" } ) + 0

MEASURE 'Report Measures'[Conditions Open] =
-- folder: Trust
-- desc: Distinct rules that attach a condition to the decision picked.
VAR Picked = [Selected Use Id]
RETURN CALCULATE ( DISTINCTCOUNT ( VerdictReasons[rule_id] ), VerdictReasons[use_id] = Picked, VerdictReasons[matters] = TRUE (), NOT ( VerdictReasons[role] = "Gate" && VerdictReasons[status] IN { "Fail", "Not checked", "No data" } ) ) + 0

MEASURE 'Report Measures'[Selected Verdict Text] =
-- folder: Trust
-- desc: One sentence that follows the verdict, so nobody has to work it out from counts.
VAR Failed = [Gates Failed]
VAR Unchecked = [Gates Unchecked]
VAR OpenCount = [Conditions Open]
VAR Picked = [Selected Use Name]
VAR Verdict = [Selected Verdict]
RETURN
    SWITCH (
        Verdict,
        "Not fit", Picked & ": not fit. " & Failed & IF ( Failed = 1, " must-pass check fails", " must-pass checks fail" ) & ", and passing the others can't outvote that.",
        "Not checked", Picked & ": not checked. " & Unchecked & IF ( Unchecked = 1, " must-pass check", " must-pass checks" ) & " couldn't be run, so nobody knows yet.",
        "Fit with conditions", Picked & ": fit, if " & OpenCount & IF ( OpenCount = 1, " condition is", " conditions are" ) & " met. Every must-pass check passes.",
        "Fit", Picked & ": fit. Everything it depends on passed.",
        "There's no verdict yet."
    )

MEASURE 'Report Measures'[Headline] =
-- folder: Trust
-- desc: The page's answer in one sentence, built from the verdicts at the last check. No figure is hard-coded.
VAR Overall = CALCULATETABLE ( Verdicts, REMOVEFILTERS ( Verdicts ), Verdicts[dataset_id] = "overall" )
VAR FitList = CONCATENATEX ( FILTER ( Overall, Verdicts[verdict] = "Fit" ), Verdicts[use_phrase], " and ", Verdicts[use_order], ASC )
VAR CondList = CONCATENATEX ( FILTER ( Overall, Verdicts[verdict] = "Fit with conditions" ), Verdicts[use_phrase], " and ", Verdicts[use_order], ASC )
VAR NotFitList = CONCATENATEX ( FILTER ( Overall, Verdicts[verdict] = "Not fit" ), Verdicts[use_phrase], " and ", Verdicts[use_order], ASC )
VAR NotCheckedList = CONCATENATEX ( FILTER ( Overall, Verdicts[verdict] = "Not checked" ), Verdicts[use_phrase], " and ", Verdicts[use_order], ASC )
VAR Parts =
    IF ( FitList <> "", "fit for " & FitList & ", " )
        & IF ( CondList <> "", "fit with conditions for " & CondList & ", " )
        & IF ( NotFitList <> "", "not fit for " & NotFitList & ", " )
        & IF ( NotCheckedList <> "", "not checked for " & NotCheckedList & ", " )
RETURN IF ( Parts = "", "There's no verdict yet.", "At the last check, this data is " & LEFT ( Parts, LEN ( Parts ) - 2 ) & "." )

MEASURE 'Report Measures'[Reason Status] =
-- folder: Trust
-- desc: The rule's outcome for the decision shown, only when it holds that decision back. Everything in the reasons table reads this.
VAR Picked = [Selected Use Id]
RETURN CALCULATE ( MAX ( VerdictReasons[status] ), VerdictReasons[use_id] = Picked, VerdictReasons[matters] = TRUE () )

MEASURE 'Report Measures'[Reason Sign] =
-- folder: Trust
-- desc: The outcome as a sign and a word, so colour is never the only cue. These signs sort fails first, then not checked, then for review.
VAR Outcome = [Reason Status]
RETURN
    SWITCH ( Outcome, "Pass", "✓ Pass", "Fail", "✗ Fail", "For review", "! For review", "Not checked", "– Not checked", "No data", "– No data" )

MEASURE 'Report Measures'[Reason Part] =
-- folder: Trust
-- desc: What the rule is to this decision, in plain words. Blank for rules not holding it back, which removes them from the table.
VAR Picked = [Selected Use Id]
VAR IsGate = CALCULATE ( COUNTROWS ( VerdictReasons ), VerdictReasons[use_id] = Picked, VerdictReasons[matters] = TRUE (), VerdictReasons[role] = "Gate" )
RETURN IF ( NOT ISBLANK ( [Reason Status] ), IF ( IsGate > 0, "Must pass", "Condition" ) )

MEASURE 'Report Measures'[Reason Needed] =
-- folder: Trust
-- desc: What a person needs to do about this rule, for the decision shown.
VAR Picked = [Selected Use Id]
RETURN CALCULATE ( MAX ( VerdictReasons[condition] ), VerdictReasons[use_id] = Picked, VerdictReasons[matters] = TRUE () )

-- ============================== Same data, different answer ==============================
MEASURE 'Report Measures'[Selected Det Code] =
-- folder: Same data
-- desc: What was measured, as its code; ammonia when nothing is picked.
COALESCE ( SELECTEDVALUE ( PickMeasured[det_code] ), "0111" )

MEASURE 'Report Measures'[Selected Det Name] =
-- folder: Same data
-- desc: What was measured, in words.
VAR Code = [Selected Det Code]
RETURN CALCULATE ( MAX ( PickMeasured[det_name] ), REMOVEFILTERS ( PickMeasured ), PickMeasured[det_code] = Code )

MEASURE 'Report Measures'[Selected Unit] =
-- folder: Same data
-- desc: The unit of what was measured.
VAR Code = [Selected Det Code]
RETURN CALCULATE ( MAX ( PickMeasured[unit_label] ), REMOVEFILTERS ( PickMeasured ), PickMeasured[det_code] = Code )

MEASURE 'Report Measures'[Your Key] =
-- folder: Same data
-- desc: Finds the scenario the pickers describe. Defaults are the stated method: half the limit, routine samples, complete months, average.
[Selected Det Code] & "|" & COALESCE ( SELECTEDVALUE ( PickMethod[Method] ), "Half the limit" ) & "|" & COALESCE ( SELECTEDVALUE ( PickSamples[SampleSet] ), "Routine samples" ) & "|" & COALESCE ( SELECTEDVALUE ( PickMonths[MonthSet] ), "Complete months" ) & "|" & COALESCE ( SELECTEDVALUE ( PickStatistic[StatKey] ), "Average" )

MEASURE 'Report Measures'[Quick Key] =
-- folder: Same data
-- desc: The quick way: drop below-limit results, use every sample and month, take a plain average.
[Selected Det Code] & "|Dropped|All samples|All months|Average"

MEASURE 'Report Measures'[Quick Figure] =
-- folder: Same data
-- desc: One sub-area's figure the quick way. Only ranked sub-areas have one.
VAR AreaNow = SELECTEDVALUE ( RankedAreas[area_name] )
VAR KeyNow = [Quick Key]
RETURN CALCULATE ( MAX ( SameData[figure] ), SameData[scenario_key] = KeyNow, SameData[area_name] = AreaNow )

MEASURE 'Report Measures'[Quick Rank] =
-- folder: Same data
-- desc: Where the quick way places one sub-area. 1 is the highest figure. This describes the calculation, not whose water is better.
VAR AreaNow = SELECTEDVALUE ( RankedAreas[area_name] )
VAR KeyNow = [Quick Key]
RETURN CALCULATE ( MAX ( SameData[area_rank] ), SameData[scenario_key] = KeyNow, SameData[area_name] = AreaNow )

MEASURE 'Report Measures'[Your Figure] =
-- folder: Same data
-- desc: One sub-area's figure, the way the pickers say.
VAR AreaNow = SELECTEDVALUE ( RankedAreas[area_name] )
VAR KeyNow = [Your Key]
RETURN CALCULATE ( MAX ( SameData[figure] ), SameData[scenario_key] = KeyNow, SameData[area_name] = AreaNow )

MEASURE 'Report Measures'[Your Rank] =
-- folder: Same data
-- desc: Where the pickers' method places one sub-area. 1 is the highest figure.
VAR AreaNow = SELECTEDVALUE ( RankedAreas[area_name] )
VAR KeyNow = [Your Key]
RETURN CALCULATE ( MAX ( SameData[area_rank] ), SameData[scenario_key] = KeyNow, SameData[area_name] = AreaNow )

MEASURE 'Report Measures'[Region Quick] =
-- folder: Same data
-- desc: The whole North West's figure the quick way.
VAR KeyNow = [Quick Key]
RETURN CALCULATE ( MAX ( SameData[figure] ), REMOVEFILTERS ( SameData ), SameData[scenario_key] = KeyNow, SameData[sub_area] = "North West" )

MEASURE 'Report Measures'[Region Yours] =
-- folder: Same data
-- desc: The whole North West's figure, the way the pickers say.
VAR KeyNow = [Your Key]
RETURN CALCULATE ( MAX ( SameData[figure] ), REMOVEFILTERS ( SameData ), SameData[scenario_key] = KeyNow, SameData[sub_area] = "North West" )

MEASURE 'Report Measures'[Quick Top Area] =
-- folder: Same data
-- desc: The sub-area ranked highest the quick way.
VAR KeyNow = [Quick Key]
RETURN CALCULATE ( MAX ( SameData[area_name] ), REMOVEFILTERS ( SameData ), SameData[scenario_key] = KeyNow, SameData[area_rank] = 1 )

MEASURE 'Report Measures'[Your Top Area] =
-- folder: Same data
-- desc: The sub-area ranked highest the way the pickers say.
VAR KeyNow = [Your Key]
RETURN CALCULATE ( MAX ( SameData[area_name] ), REMOVEFILTERS ( SameData ), SameData[scenario_key] = KeyNow, SameData[area_rank] = 1 )

MEASURE 'Report Measures'[Same Data Headline] =
-- folder: Same data
-- desc: The finding as a plain comparison, built from the two figures. It follows the direction of the difference.
VAR Quick = [Region Quick]
VAR Yours = [Region Yours]
VAR Unit = [Selected Unit]
VAR TopQuick = [Quick Top Area]
VAR TopYours = [Your Top Area]
VAR Times = IF ( Quick > 0 && Yours > 0, MAX ( Quick, Yours ) / MIN ( Quick, Yours ) )
RETURN
    IF (
        ISBLANK ( Quick ) || ISBLANK ( Yours ),
        "There's no figure for this combination.",
        "The quick way gives " & FORMAT ( Quick, "0.00" ) & " " & Unit & " for the North West. Your way gives " & FORMAT ( Yours, "0.00" ) & " " & Unit
            & IF ( Times >= 1.05, ", about " & FORMAT ( Times, IF ( Times >= 10, "0", "0.0" ) ) & " times " & IF ( Yours < Quick, "lower", "higher" ) )
            & ". "
            & IF ( TopQuick <> TopYours, "The highest sub-area changes from " & TopQuick & " to " & TopYours & ".", "The highest sub-area stays " & TopYours & "." )
    )

MEASURE 'Report Measures'[Showing Same Data] =
-- folder: Same data
-- desc: What is selected, in large type at the top of the page.
[Selected Det Name] & " in rivers  ·  " & COALESCE ( SELECTEDVALUE ( PickMethod[Below-limit results] ), "Count at half the limit" ) & "  ·  " & COALESCE ( SELECTEDVALUE ( PickSamples[Samples] ), "Routine samples only" ) & "  ·  " & COALESCE ( SELECTEDVALUE ( PickMonths[Months] ), "Complete months only" ) & "  ·  " & COALESCE ( SELECTEDVALUE ( PickStatistic[Statistic] ), "Average" )

MEASURE 'Report Measures'[Is Default Same Data] =
-- folder: Same data
-- desc: 1 while the page still shows its starting example.
IF ( [Your Key] = "0111|Half the limit|Routine samples|Complete months|Average", 1, 0 )

MEASURE 'Report Measures'[Switch Figure] =
-- folder: Same data
-- desc: The North West's figure with one switch changed from the quick way.
VAR Code = [Selected Det Code]
VAR KeyNow = Code & "|" & SELECTEDVALUE ( SwitchEffects[Method] ) & "|" & SELECTEDVALUE ( SwitchEffects[SampleSet] ) & "|" & SELECTEDVALUE ( SwitchEffects[MonthSet] ) & "|" & SELECTEDVALUE ( SwitchEffects[StatKey] )
RETURN CALCULATE ( MAX ( SameData[figure] ), REMOVEFILTERS ( SameData ), SameData[scenario_key] = KeyNow, SameData[sub_area] = "North West" )

MEASURE 'Report Measures'[Switch Base] =
-- folder: Same data
-- desc: The quick way's figure, repeated on each row of the switch chart, so bars can start from it.
[Region Quick]

-- ============================== Rules and exceptions ==============================
MEASURE 'Report Measures'[Selected Rule Id] =
-- folder: Rules
-- desc: The rule picked, or blank when several are in view. The chart uses it to highlight a row.
SELECTEDVALUE ( Rules[id] )

MEASURE 'Report Measures'[Rule Card Text] =
-- folder: Rules
-- desc: The rule's result in one sentence, using the true number of failed records.
VAR Outcome = SELECTEDVALUE ( Rules[status] )
VAR Failed = SUM ( Rules[failed] )
VAR Checked = SUM ( Rules[eligible] )
VAR ShareFailed = SUM ( Rules[failed_pct] )
RETURN
    SWITCH (
        Outcome,
        "Not checked", "This rule couldn't run at the last check. " & SELECTEDVALUE ( Rules[note] ),
        "No data", "There was nothing for this rule to check.",
        BLANK (), "Pick a rule to see its result.",
        FORMAT ( Failed, "#,0" ) & " of " & FORMAT ( Checked, "#,0" ) & " records (" & FORMAT ( ShareFailed, IF ( ShareFailed >= 1, "0.0", "0.0##" ) ) & "%) break this rule."
    )

MEASURE 'Report Measures'[Rule Threshold Text] =
-- folder: Rules
-- desc: The rule's stated tolerance. Thresholds are illustrative.
VAR FailAbove = SELECTEDVALUE ( Rules[fail_above] )
VAR ReviewAbove = SELECTEDVALUE ( Rules[review_above] )
RETURN
    IF ( NOT ISBLANK ( FailAbove ), IF ( FailAbove = 0, "Any break fails it", "Fails above " & FailAbove & "%" ), "Never fails outright" )
        & IF ( NOT ISBLANK ( ReviewAbove ) && ( ISBLANK ( FailAbove ) || ReviewAbove < FailAbove ), ". Needs review above " & ReviewAbove & "%" )
        & ". Illustrative."

MEASURE 'Report Measures'[Rule Effect Text] =
-- folder: Rules
-- desc: Whether this rule's problem changes the answer, with the two figures. Says so plainly when no effect was measured. Whole numbers are shown without a stray decimal point.
VAR Measured = SELECTEDVALUE ( Rules[measured] )
VAR Careful = SUM ( Rules[careful] )
VAR Careless = SUM ( Rules[careless] )
VAR Effect = SUM ( Rules[effect_pct] )
VAR Unit = SELECTEDVALUE ( Rules[unit] )
VAR CarefulText = FORMAT ( Careful, IF ( ROUND ( Careful, 2 ) = ROUND ( Careful, 0 ), "#,0", "#,0.00" ) )
VAR CarelessText = FORMAT ( Careless, IF ( ROUND ( Careless, 2 ) = ROUND ( Careless, 0 ), "#,0", "#,0.00" ) )
RETURN
    IF (
        Measured = TRUE (),
        SELECTEDVALUE ( Rules[figure] ) & ": " & CarefulText & " worked out carefully, " & CarelessText & " carelessly"
            & IF ( Unit <> "", " (" & Unit & ")" )
            & IF ( NOT ISBLANK ( Effect ), ". That moves it by " & FORMAT ( Effect, "+#,0.0;-#,0.0" ) & "%." , "." ),
        "No effect on a figure was measured for this rule."
    )

MEASURE 'Report Measures'[Rule Test Text] =
-- folder: Rules
-- desc: Whether the rule caught its planted defect at the last check.
VAR Outcome = SELECTEDVALUE ( Rules[test_outcome] )
VAR CountBefore = SUM ( Rules[test_failed_before] )
VAR CountAfter = SUM ( Rules[test_failed_after] )
RETURN
    SWITCH (
        Outcome,
        "Caught", "Caught at the last check: its count rose from " & FORMAT ( CountBefore, "#,0" ) & " to " & FORMAT ( CountAfter, "#,0" ) & " when its own defect was planted in a private copy.",
        "Missed", "Missed at the last check: this rule didn't notice its own planted defect.",
        "Proved by its own test", "This rule checks the others. A separate test proves it fails when a rule misses.",
        "Not checked", "Not tested at the last check, because the rule couldn't run.",
        "Not tested at the last check."
    )

MEASURE 'Report Measures'[Showing Rules] =
-- folder: Rules
-- desc: What is selected, in large type at the top of the page.
COALESCE ( SELECTEDVALUE ( Rules[rule_label] ), "Every rule" ) & "  ·  " & [Rules Total] & " rules run every night"

MEASURE 'Report Measures'[Showing Exceptions] =
-- folder: Rules
-- desc: What is selected, in large type at the top of the exceptions page.
COALESCE ( SELECTEDVALUE ( Rules[rule_label] ), "Pick a rule" ) & IF ( ISFILTERED ( Exceptions[month_label] ), "  ·  " & SELECTEDVALUE ( Exceptions[month_label] ) )

MEASURE 'Report Measures'[Is Default Rule] =
-- folder: Rules
-- desc: 1 while the page still shows its starting example.
IF ( SELECTEDVALUE ( Rules[id] ) = "VAL-07", 1, 0 )

MEASURE 'Report Measures'[Exceptions Shown] =
-- folder: Rules
-- desc: Failed records listed for what is picked.
COUNTROWS ( Exceptions ) + 0

MEASURE 'Report Measures'[Exception Rule] =
-- folder: Rules
-- desc: The rule a listed record broke, shown on each row. It's blank for records of other rules, which keeps the list to the rule picked.
IF ( COUNTROWS ( Exceptions ) > 0, SELECTEDVALUE ( Rules[id] ) )

MEASURE 'Report Measures'[Exceptions Text] =
-- folder: Rules
-- desc: States the true total beside the rows shown, so nobody takes a capped list for the whole story.
VAR Shown = [Exceptions Shown]
VAR TrueTotal = SUM ( Rules[failed] )
VAR Picked = SELECTEDVALUE ( Rules[id] )
VAR MonthPicked = ISFILTERED ( Exceptions[month_label] )
RETURN
    IF (
        ISBLANK ( Picked ),
        "Pick a rule to see its failed records.",
        IF (
            TrueTotal = 0,
            "Nothing failed this rule at the last check.",
            IF (
                MonthPicked,
                "Showing " & FORMAT ( Shown, "#,0" ) & " listed records for that month. This rule has " & FORMAT ( TrueTotal, "#,0" ) & " in all.",
                IF (
                    Shown < TrueTotal,
                    "Showing the newest " & FORMAT ( Shown, "#,0" ) & " of " & FORMAT ( TrueTotal, "#,0" ) & " failed records. The count comes from the check itself, and only the listing is capped.",
                    "Showing all " & FORMAT ( TrueTotal, "#,0" ) & " failed records."
                )
            )
        )
    )

-- ============================== How it works ==============================
MEASURE 'Report Measures'[Lineage Lost Rows] =
-- folder: How it works
-- desc: Rows lost between the source and the report. Should be nothing.
[Source Rows] - [Summarised Rows]

MEASURE 'Report Measures'[Planted Text] =
-- folder: How it works
-- desc: The planted defect result, in a sentence.
FORMAT ( [Planted Caught], "0" ) & " of " & FORMAT ( [Planted Tested], "0" ) & " planted defects were caught. A rule that misses its own defect fails CHK-01, which every decision must pass. The defects only ever go into a private copy, and the source data is never changed."

MEASURE 'Report Measures'[Watch Sign] =
-- folder: How it works
-- desc: Each publisher statement at the last check, with a sign and a word. A change is a prompt to look, not a fault.
VAR Outcome = SELECTEDVALUE ( SourceWatch[status] )
VAR PrintBefore = SELECTEDVALUE ( SourceWatch[previous_fingerprint] )
VAR PrintLatest = SELECTEDVALUE ( SourceWatch[fingerprint] )
RETURN
    SWITCH (
        TRUE (),
        Outcome <> "ok", "– Couldn't be read",
        PrintBefore = "", "✓ Read, first look",
        PrintBefore <> PrintLatest, "! Changed: please look",
        "✓ Read, unchanged"
    )

MEASURE 'Report Measures'[Fingerprints Text] =
-- folder: How it works
-- desc: How many records the ledger is tracking.
VAR LastRun = CALCULATE ( MAX ( Ledger[run_id] ), REMOVEFILTERS ( Ledger ) )
VAR Tracked = CALCULATE ( MAX ( Ledger[records_now] ), REMOVEFILTERS ( Ledger ), Ledger[run_id] = LastRun )
RETURN FORMAT ( Tracked, "#,0" ) & " records fingerprinted at the last run."

MEASURE 'Report Measures'[Bathing Source Text] =
-- folder: How it works
-- desc: Says plainly whether the second service was read live, or stood in for by a saved copy.
VAR Latest = [Latest Run No]
VAR State = CALCULATE ( MAX ( RunLog[bathing_status] ), REMOVEFILTERS ( RunLog ), RunLog[RunNo] = Latest )
VAR Taken = CALCULATE ( MAX ( Manifest[taken_on] ), Manifest[source] = "bathing" )
RETURN
    SWITCH (
        State,
        "ok", "The bathing water service was read live at the last check.",
        "copy", "The bathing water service doesn't accept requests from the server that runs the nightly check, so a copy taken on " & FORMAT ( Taken, "d mmm yyyy" ) & " stands in. A rule says when it's out of date.",
        "The bathing water service couldn't be read at the last check, and its rules show Not checked."
    )

MEASURE 'Report Measures'[Licence Text] =
-- folder: How it works
-- desc: The licence statements as read at the last check, with a polite note when they differ.
VAR Different = CALCULATE ( COUNTROWS ( SourceWatch ), SourceWatch[kind] = "licence", SourceWatch[status] = "ok", SourceWatch[value] <> "Open Government Licence" )
RETURN
    IF (
        Different > 0,
        "The service's own pages state the Open Government Licence v3.0, which this report relies on. Its catalogue record reads differently, so that's recorded as a question for a steward.",
        "The statements read at the last check agree on the Open Government Licence v3.0."
    )

MEASURE 'Report Measures'[Points Shown] =
-- folder: Points
-- desc: How many sampling points the pickers leave in view.
COALESCE ( COUNTROWS ( PointQuality ), 0 )

MEASURE 'Report Measures'[Points No Flags] =
-- folder: Points
-- desc: Points where every check passed. FILTER rather than a CALCULATE, so it respects a picker on the band.
COALESCE ( COUNTROWS ( FILTER ( PointQuality, PointQuality[band] = "No flags" ) ), 0 )

MEASURE 'Report Measures'[Points A Few Flags] =
-- folder: Points
-- desc: Points flagged but still scoring 95 or more. Illustrative.
COALESCE ( COUNTROWS ( FILTER ( PointQuality, PointQuality[band] = "A few flags" ) ), 0 )

MEASURE 'Report Measures'[Points Look Closer] =
-- folder: Points
-- desc: Points flagged and scoring under 95, for a person to look at. Illustrative.
COALESCE ( COUNTROWS ( FILTER ( PointQuality, PointQuality[band] = "Look closer" ) ), 0 )

MEASURE 'Report Measures'[Points No Results] =
-- folder: Points
-- desc: Open points with nothing in the window, so nothing to score. Not a pass and not a fail.
COALESCE ( COUNTROWS ( FILTER ( PointQuality, PointQuality[band] = "No results to check" ) ), 0 )

MEASURE 'Report Measures'[Showing Points] =
-- folder: Points
-- desc: What is selected, in words, for the top of the page. Lists up to two choices, then gives a number.
VAR Shown = [Points Shown]
VAR Areas = VALUES ( PointPacks[area_name] )
VAR Kinds = VALUES ( PointPacks[point_group] )
VAR Bands = VALUES ( PointPacks[band] )
VAR AreaText =
    IF (
        NOT ISFILTERED ( PointPacks[area_name] ),
        "all of North West England",
        IF ( COUNTROWS ( Areas ) <= 2, CONCATENATEX ( Areas, PointPacks[area_name], " and " ), COUNTROWS ( Areas ) & " areas" )
    )
VAR KindText =
    IF (
        NOT ISFILTERED ( PointPacks[point_group] ),
        "every type",
        IF ( COUNTROWS ( Kinds ) <= 2, CONCATENATEX ( Kinds, PointPacks[point_group], " and " ), COUNTROWS ( Kinds ) & " types" )
    )
VAR BandText =
    IF (
        NOT ISFILTERED ( PointPacks[band] ),
        "",
        " · " & IF ( COUNTROWS ( Bands ) <= 2, CONCATENATEX ( Bands, PointPacks[band], " and " ), COUNTROWS ( Bands ) & " bands" )
    )
RETURN
    FORMAT ( Shown, "#,0" ) & IF ( Shown = 1, " sampling point", " sampling points" ) & " · " & AreaText & " · " & KindText & BandText

MEASURE 'Report Measures'[Point Score] =
-- folder: Points
-- desc: One point's score out of 100. Blank with no results, because nothing was checked. Illustrative.
IF ( HASONEVALUE ( PointQuality[point_id] ), SELECTEDVALUE ( PointQuality[score] ) )

MEASURE 'Report Measures'[Point Quality] =
-- folder: Points
-- desc: One point's band with a sign and a word, so colour is never the only cue. Blank outside the pickers, which also keeps the list filtered.
SWITCH (
    SELECTEDVALUE ( PointQuality[band] ),
    "No flags", "✓ No flags",
    "A few flags", "! A few flags",
    "Look closer", "✗ Look closer",
    "No results to check", "– No results"
)

MEASURE 'Report Measures'[Point Quality Colour] =
-- folder: Points
-- desc: The colour of a point's band, for the words in a table.
SWITCH (
    SELECTEDVALUE ( PointQuality[band] ),
    "No flags", "#4CD8B0",
    "A few flags", "#F2CE6B",
    "Look closer", "#FF8A73",
    "#CAD4E3"
)

MEASURE 'Report Measures'[Point Flags] =
-- folder: Points
-- desc: Records flagged at this point by the checks in the score. One record can be flagged by two checks.
SUM ( PointQuality[flags] )

MEASURE 'Report Measures'[Point Results] =
-- folder: Points
-- desc: Results checked at this point in the window.
SUM ( PointQuality[results] )

MEASURE 'Report Measures'[Showing Point] =
-- folder: Points
-- desc: The point chosen, for the top of its page.
IF ( HASONEVALUE ( PointQuality[point_id] ), SELECTEDVALUE ( PointQuality[point_label] ), "choose a point on the Map page" )

MEASURE 'Report Measures'[Point Source Url] =
-- folder: Points
-- desc: The chosen point's page at source, so anyone can check it.
SELECTEDVALUE ( PointQuality[source_url] )

MEASURE 'Report Measures'[Checks Ran] =
-- folder: Points
-- desc: How many checks reached the chosen point.
IF ( HASONEVALUE ( PointQuality[point_id] ), COALESCE ( COUNTROWS ( PointChecks ), 0 ) )

MEASURE 'Report Measures'[Checks Flagged] =
-- folder: Points
-- desc: How many of those checks flagged something, including those shown but not scored.
IF ( HASONEVALUE ( PointQuality[point_id] ), COALESCE ( COUNTROWS ( FILTER ( PointChecks, PointChecks[flagged] > 0 ) ), 0 ) )

MEASURE 'Report Measures'[Point Explain Text] =
-- folder: Points
-- desc: What the chosen point's score means, in a sentence that follows its band.
VAR Band = SELECTEDVALUE ( PointQuality[band] )
RETURN
    IF (
        HASONEVALUE ( PointQuality[point_id] ),
        SWITCH (
            Band,
            "No results to check", "This point is listed as open, but no results arrived in the window. Nothing can be scored, so it stays grey rather than counting as a pass.",
            "No flags", "Every check in the score passed here. That shows its records are complete and consistent. It doesn't show that a reading is true or the water is clean.",
            [Checks Flagged] & " of " & [Checks Ran] & " checks flagged something here. The score is the share of records passing each check, weighted by how serious the check is. It is illustrative, and it never overrides a must-pass check."
        )
    )

MEASURE 'Report Measures'[Point Checks Title] =
-- folder: Points
-- desc: The title of the chosen point's list of checks.
IF (
    HASONEVALUE ( PointQuality[point_id] ),
    [Checks Ran] & " checks reached this point, and " & [Checks Flagged] & " flagged something",
    "Choose a point to see its checks"
)

MEASURE 'Report Measures'[Check Records] =
-- folder: Points
-- desc: Records this check looked at, at this point.
SUM ( PointChecks[checked] )

MEASURE 'Report Measures'[Check Flagged Records] =
-- folder: Points
-- desc: Records this check flagged, at this point.
SUM ( PointChecks[flagged] )

MEASURE 'Report Measures'[Check Share] =
-- folder: Points
-- desc: The share of the records it looked at that it flagged.
DIVIDE ( [Check Flagged Records], [Check Records] )

MEASURE 'Report Measures'[Check Outcome] =
-- folder: Points
-- desc: What a check found at this point, with a sign and a word. Something shown but not scored is a prompt, not a failure.
VAR Flagged = [Check Flagged Records]
VAR Counted = SELECTEDVALUE ( PointChecks[counts_in_score] )
RETURN
    IF (
        NOT ISBLANK ( COUNTROWS ( PointChecks ) ),
        IF ( Flagged = 0, "✓ Clear", IF ( Counted = "True", "✗ Flagged", "! For information" ) )
    )

MEASURE 'Report Measures'[Check Outcome Colour] =
-- folder: Points
-- desc: The colour of a check's outcome, for the words in a table.
VAR Outcome = LEFT ( [Check Outcome], 1 )
RETURN
    SWITCH ( Outcome, "✓", "#4CD8B0", "✗", "#FF8A73", "!", "#F2CE6B", "#CAD4E3" )

MEASURE 'Report Measures'[Check Counted] =
-- folder: Points
-- desc: Whether this check counts towards the score, and why not if it doesn't.
VAR Counted = SELECTEDVALUE ( PointChecks[counts_in_score] )
VAR Rule = SELECTEDVALUE ( PointChecks[rule_id] )
RETURN
    IF (
        NOT ISBLANK ( COUNTROWS ( PointChecks ) ),
        SWITCH (
            TRUE (),
            Counted = "True", "Yes",
            Rule = "VAL-07", "No: normal reporting",
            Rule = "AI-04", "No: an open question",
            "No: no results to score"
        )
    )

MEASURE 'Report Measures'[Exception Rule Here] =
-- folder: Points
-- desc: The rule behind a flagged record. Blank for records at other points, which keeps the list to the chosen point.
MAX ( Exceptions[rule_id] )

MEASURE 'Report Measures'[Point Records Title] =
-- folder: Points
-- desc: The title of the chosen point's flagged records, saying that the list is capped so it can't be mistaken for the total.
VAR Kept = COALESCE ( COUNTROWS ( Exceptions ), 0 )
RETURN
    IF (
        HASONEVALUE ( PointQuality[point_id] ),
        FORMAT ( Kept, "#,0" ) & " flagged records kept for this point. Up to 500 are kept per rule across all points, so this list can be shorter than the counts above",
        "Choose a point to see its flagged records"
    )
