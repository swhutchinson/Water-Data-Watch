    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "How a verdict is reached",
                    "textStyle": {
                      "fontFamily": "Bahnschrift",
                      "fontSize": "15pt",
                      "color": "#FFFFFF",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "6pt",
                      "color": "#FFFFFF"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Each decision lists the rules it depends on. Some must pass, and the rest attach a condition.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "13.5pt",
                      "color": "#FFFFFF"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "6pt",
                      "color": "#FFFFFF"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "One failed must-pass check makes the verdict Not fit. Passing the others can't outvote it, and nothing is averaged.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "13.5pt",
                      "color": "#FFFFFF"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "6pt",
                      "color": "#FFFFFF"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "A must-pass check that couldn't run makes the verdict Not checked. That isn't a pass and it isn't a fail.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "13.5pt",
                      "color": "#FFFFFF"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "6pt",
                      "color": "#FFFFFF"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Issues open by themselves when a rule fails, and close after three passes in a row. A night with no check changes nothing.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "13.5pt",
                      "color": "#FFFFFF"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "6pt",
                      "color": "#FFFFFF"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Automation checks and reports. People decide what to do about anything marked For review.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "13.5pt",
                      "color": "#FFFFFF"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "6pt",
                      "color": "#FFFFFF"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Passing every rule doesn't make a reading true. It shows the data is complete and consistent against these rules.",
                    "textStyle": {
                      "fontFamily": "Bahnschrift",
                      "fontSize": "13.5pt",
                      "color": "#FFFFFF",
                      "fontWeight": "bold"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
